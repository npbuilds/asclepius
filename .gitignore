# ============================================================
# Python (anchored to root so `web/lib/` is NOT accidentally matched)
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Build / packaging artifacts — anchored to project root
/build/
/dist/
/develop-eggs/
/downloads/
/eggs/
/.eggs/
/sdist/
/var/
/wheels/
/parts/
/lib64/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual envs — match anywhere because venvs can live in subdirs
.venv/
venv/
env/
ENV/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

