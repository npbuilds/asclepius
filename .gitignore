# ============================================================
# Python (anchored to root so `web/lib/` is NOT accidentally matched)
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Build / packaging artifacts — anchored to project root
/build/
/dist/
/develop-eggs/
/downloads/
/eggs/
/.eggs/
/sdist/
/var/
/wheels/
/parts/
/lib64/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual envs — match anywhere because venvs can live in subdirs
.venv/
venv/
env/
ENV/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# ============================================================
# Node / Next.js
# ============================================================
node_modules/
.next/
out/
.pnpm-store/
*.tsbuildinfo
next-env.d.ts

# Web-specific build artifacts (anchored — `/build/` at repo root is the Next.js build)
web/.next/
web/out/
web/.vercel/

# Auto-generated by web/scripts/sync-methodology.mjs at predev / prebuild / typecheck time.
# Don't commit — it regenerates from methodology/*.md on every script run.
web/lib/methodology-content.ts

# ============================================================
# Env
# ============================================================
.env
.env.local
.env.*.local

# ============================================================
