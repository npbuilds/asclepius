.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# ============================================================
# Node / Next.js
# ============================================================
node_modules/
.next/
out/
.pnpm-store/
*.tsbuildinfo
next-env.d.ts

# Web-specific build artifacts (anchored — `/build/` at repo root is the Next.js build)
web/.next/
web/out/
web/.vercel/

# Root Vercel project link — contains linked project/org IDs (and a README
# stating it must not be shared). Anchored to root so only the top-level link
# is ignored, not anything named .vercel deeper in the tree.
/.vercel/

# Auto-generated by web/scripts/sync-methodology.mjs from methodology/*.md.
# COMMITTED to git because Vercel only deploys the web/ subdirectory and
# can't see ../methodology/ at build time. Local dev still regenerates this
# file via predev/prebuild/typecheck — when you edit methodology/*.md, commit
# both the .md change and the regenerated .ts in the same commit.
# (See web/scripts/sync-methodology.mjs comments for rationale.)
# web/lib/methodology-content.ts

# ============================================================
# Env
# ============================================================
.env
.env.local
.env.*.local

# ============================================================
# Logs
# ============================================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ============================================================
# Local databases (Calibration Dashboard SQLite in v1.5)
# ============================================================
*.sqlite
*.sqlite3
*.db
api/app/data/calibration.db

# ============================================================
# Methodology staging (api/scripts/fly_deploy.sh)
# ============================================================
# Staged copy of /methodology/ into the Docker build context immediately
# before flyctl deploy, cleaned up after. Source of truth stays in
# /methodology/ only. Local-dev agents read /methodology/ directly via
# the path resolution in api/app/agents/base.py.
api/app/methodology/

# ============================================================
# v1.5.2 BioBERT training pipeline data + scratch artifacts
# ============================================================
# Training pipeline is offline; the HINT corpus (~500MB raw CSVs) lives
# here and is fetched via api/data_pipeline/download_hint.sh. The
# intermediate parquet (~50-200MB) lives at data/training/.
# The shipped model artifact (api/app/modules/ml_pos_prior/model.joblib)
# is tracked normally; the embeddings.npy ships via Git LFS once it
# lands.
api/data/hint/
api/data/training/

# v1.5.5 — CT Open benchmark data (Gao et al. 2024, ~19 MB CTO CSVs +
# downstream artifacts). Downloaded from
# https://huggingface.co/datasets/chufangao/CTO via the helper script at
# api/data_pipeline/cto_download.sh. Not vendored into the repo.
api/data/cto/
