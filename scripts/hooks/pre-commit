#!/usr/bin/env bash
# Pre-commit hook — keep the build-artifact file in sync with its source.
#
# WHY: methodology/*.md is the source-of-truth for the methodology writeups;
# web/lib/methodology-content.ts (+ web/lib/methodology-count.ts) are generated
# TypeScript modules the Next.js app imports at build time (Vercel only deploys
# web/, so the generated files have to be in git — see
# web/scripts/sync-methodology.mjs for the constraint). The sync script also
# auto-runs on `predev` and `prebuild` and inside `pnpm typecheck`, so LOCAL
# development always sees the right content even when the committed artifact is
# stale. Drift is invisible until someone hits the live deploy.
#
# This hook closes the loop at commit time: if any methodology .md is staged
# (including a stage-for-deletion), re-run the sync and auto-stage the
# regenerated artifacts alongside the source change. Belt-and-suspenders with
# the CI drift check in .github/workflows/ci.yml.
#
# (The predictions/*.json → predictions-content.ts sync this hook used to also
# handle was removed in the R2 rescope — the prediction-log surface was cut.)
#
# INSTALL: ./scripts/hooks/install.sh (symlinks into .git/hooks/pre-commit).
# UNINSTALL: rm .git/hooks/pre-commit. Bypass for one commit: git commit --no-verify.

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# What's actually staged? Act if the staged set includes ANY change to a sync
# source — including deletes. ACMRD covers Add / Copy / Modify / Rename / Delete.
staged_methodology="$(git diff --cached --name-only --diff-filter=ACMRD | grep -E '^methodology/.*\.md$' || true)"

if [[ -z "$staged_methodology" ]]; then
  # No sync sources touched; nothing to do.
  exit 0
fi

# Sync scripts are Node ESM. If node isn't available we don't block the commit —
# warn and proceed; CI will catch any drift that lands on main.
if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: WARNING — node not on PATH; skipping sync (CI will check)" >&2
  exit 0
fi

# If a staged sync-source ALSO has unstaged edits, the regenerated artifact will
# reflect the full working-tree content, not staged-only. Warn; CI is the
# backstop. We do not stash (a stash push/pop inside a hook can corrupt the tree).
unstaged_sources="$(git diff --name-only -- methodology | grep -E '^methodology/.*\.md$' || true)"
if [[ -n "$unstaged_sources" ]]; then
  echo "pre-commit: NOTE — these methodology sources have unstaged edits; the regenerated" >&2
  echo "pre-commit:        artifact will reflect the full working tree, not staged-only:" >&2
  echo "$unstaged_sources" | sed 's/^/pre-commit:          /' >&2
fi

cd web
echo "pre-commit: methodology .md changes staged → re-syncing methodology-content.ts"
node scripts/sync-methodology.mjs >/dev/null
cd "$repo_root"

# Stage the regenerated artifacts. `git add` is a no-op if the sync produced no
# change, so this is safe whether or not the content moved.
git add web/lib/methodology-content.ts web/lib/methodology-count.ts 2>/dev/null || true

echo "pre-commit: sync complete — staged artifacts now match sources"
